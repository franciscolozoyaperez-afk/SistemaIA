# SIGSE-CETIS 61 - Variables de entorno de ejemplo
# Copia este archivo a .env.local dentro de cada app o configura las variables en Vercel.
# No coloques secretos reales en este archivo.

# -----------------------------------------------------------------------------
# Backend Node.js (apps/backend)
# -----------------------------------------------------------------------------

# URL pública del proyecto Supabase, por ejemplo: https://PROJECT_REF.supabase.co
SUPABASE_URL=https://your-project-ref.supabase.co

# Clave service_role: SOLO backend/Vercel. Nunca exponerla al frontend.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Orígenes permitidos para CORS, separados por comas.
API_CORS_ORIGINS=http://localhost:5173,https://your-frontend-domain.vercel.app

# Puerto local del backend.
PORT=3001

# Rate limiting del API.
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120

# -----------------------------------------------------------------------------
# Frontend Svelte (apps/frontend)
# -----------------------------------------------------------------------------

# Variables públicas consumidas por Vite/SvelteKit. La anon key es segura para
# el navegador porque Supabase Auth y RLS limitan sus permisos.
PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Base del API. En desarrollo usa /api para aprovechar el proxy de Vite.
# En producción puede apuntar al dominio del backend, por ejemplo:
# https://sigse-cetis61-api.vercel.app/api
PUBLIC_API_BASE_URL=/api

# Destino del proxy /api durante desarrollo local.
VITE_API_PROXY_TARGET=http://localhost:3001
